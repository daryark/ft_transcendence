generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                                          Int                 @id @default(autoincrement())
  email                                       String              @unique @db.VarChar(255)
  username                                    String              @unique @db.VarChar(100)
  password_hash                               String              @db.VarChar(255)
  avatar_id                                   Int?                @default(0)
  country                                     String?             @db.VarChar(100)
  level                                       Int?                @default(1)
  xp                                          Int?                @default(0)
  next_level_xp                               Int?                @default(100)
  league_elo                                  Int?                @default(1000)
  league_rank                                 String?             @default("D") @db.VarChar(16)
  play_time_seconds                           Int?                @default(0)
  wins                                        Int?                @default(0)
  created_at                                  DateTime?           @default(now()) @db.Timestamp(6)
  friends_friends_friend_idTousers            friends[]           @relation("friends_friend_idTousers")
  friends_friends_user_idTousers              friends[]           @relation("friends_user_idTousers")
  match_players                               match_players[]
  messages_messages_receiver_idTousers        messages[]          @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers          messages[]          @relation("messages_sender_idTousers")
  notifications_notifications_actor_idTousers notifications[]     @relation("notifications_actor_idTousers")
  notifications_notifications_user_idTousers  notifications[]     @relation("notifications_user_idTousers")
  oauth_accounts                              oauth_accounts[]
  user_achievements                           user_achievements[]
}

model friends {
  id                             Int            @id @default(autoincrement())
  user_id                        Int
  friend_id                      Int
  status                         friend_status? @default(pending)
  created_at                     DateTime?      @default(now()) @db.Timestamp(6)
  users_friends_friend_idTousers users          @relation("friends_friend_idTousers", fields: [friend_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friends_friend")
  users_friends_user_idTousers   users          @relation("friends_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friends_user")

  @@unique([user_id, friend_id], map: "unique_friendship")
}

model match_players {
  id                        Int            @id @default(autoincrement())
  match_id                  Int
  user_id                   Int
  score                     Int?           @default(0)
  metric_value              Float?
  rank_label                String?        @db.VarChar(16)
  result                    player_result?
  lines                     Int            @default(0)
  pieces_placed             Int            @default(0)
  hard_drops                Int            @default(0)
  holds                     Int            @default(0)
  max_combo                 Int            @default(0)
  max_lines_cleared         Int            @default(0)
  cleared_two_at_once       Boolean        @default(false)
  cleared_three_at_once     Boolean        @default(false)
  tetrises                  Int            @default(0)
  duration_ms               Int            @default(0)
  cleared_after_half_height Boolean        @default(false)
  matches                   matches        @relation(fields: [match_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_match_players_match")
  users                     users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_match_players_user")
}

model achievements {
  id                Int                 @id
  code              String              @unique @db.VarChar(80)
  name              String              @db.VarChar(120)
  description       String
  rarity            String              @db.VarChar(20)
  target            Int
  user_achievements user_achievements[]
}

model user_achievements {
  id             Int          @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  unlocked_at    DateTime     @default(now()) @db.Timestamp(6)
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_achievements_achievement")
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_achievements_user")

  @@unique([user_id, achievement_id], map: "unique_user_achievement")
}

model matches {
  id            Int             @id @default(autoincrement())
  status        match_status?   @default(active)
  gamemode      gamemode?       @default(quickPlay)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  match_players match_players[]
}

model messages {
  id                                Int        @id @default(autoincrement())
  sender_id                         Int
  receiver_id                       Int
  content                           String
  reply_to_id                       Int?
  created_at                        DateTime?  @default(now()) @db.Timestamp(6)
  read_at                           DateTime?  @db.Timestamp(6)
  users_messages_receiver_idTousers users      @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_messages_receiver")
  messages                          messages?  @relation("messagesTomessages", fields: [reply_to_id], references: [id], onUpdate: NoAction, map: "fk_messages_reply")
  other_messages                    messages[] @relation("messagesTomessages")
  users_messages_sender_idTousers   users      @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_messages_sender")

  @@index([sender_id, receiver_id, id], map: "idx_messages_conversation")
}

model notifications {
  id                                  Int       @id @default(autoincrement())
  user_id                             Int
  actor_id                            Int?
  type                                String    @db.VarChar(50)
  title                               String    @db.VarChar(120)
  body                                String
  link                                String?   @db.VarChar(255)
  payload                             Json?
  is_read                             Boolean   @default(false)
  created_at                          DateTime? @default(now()) @db.Timestamp(6)
  read_at                             DateTime? @db.Timestamp(6)
  users_notifications_actor_idTousers users?    @relation("notifications_actor_idTousers", fields: [actor_id], references: [id], onUpdate: NoAction, map: "fk_notifications_actor")
  users_notifications_user_idTousers  users     @relation("notifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")
}

model oauth_accounts {
  id               Int       @id @default(autoincrement())
  user_id          Int
  provider         String    @db.VarChar(50)
  provider_user_id String    @db.VarChar(255)
  provider_data    Json?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oauth_user")

  @@unique([provider, provider_user_id], map: "unique_provider_user")
}

enum friend_status {
  pending
  accepted
  blocked
}

enum match_status {
  active
  finished
}

enum player_result {
  win
  lose
  draw
}

enum gamemode {
  quickPlay
  tetraLeague
  fortyLines
  blitz
  zen
  customGame
}
