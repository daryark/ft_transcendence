{
  "schedule": "0 30 2 * * ?",
  "name": "<nginx-logs-snap-{now/d}>",
  "repository": "trans_archive",
  "config": {
    "indices": ["nginx-logs-*"],
    "ignore_unavailable": true,
    "include_global_state": false
  },
  "retention": {
    "expire_after": "5m",
    "min_count": 7,
    "max_count": 90
  }
}